rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Setlists existantes
    match /setlists/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Subscription — lecture seule pour l'utilisateur, écriture webhook only
    match /users/{userId}/subscription {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Export count — l'utilisateur peut lire/creer/incrémenter (max 3)
    match /users/{userId}/exports/{monthDoc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count <= 3;
      allow update: if request.auth != null && request.auth.uid == userId
        && resource.data.count < 3
        && request.resource.data.count == resource.data.count + 1;
    }

    // Bloque tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}