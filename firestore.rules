rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Setlists existantes
    match /setlists/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Subscription — lecture seule pour l'utilisateur, écriture webhook only
    // Attention : le chemin réel est users/{userId}/subscription/main (4 segments)
    // Il faut match /users/{userId}/subscription/{docId} pour atteindre le document
    match /users/{userId}/subscription/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Export count — l'utilisateur peut lire/créer/incrémenter (max 2)
    // La création impose count=1 (pas <= 2) pour éviter de brûler le quota en 1 appel
    // L'update vérifie que count ne fait qu'incrémenter de 1 et que < 2
    match /users/{userId}/exports/{monthDoc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count == 1
        && request.resource.data.month == monthDoc;
      allow update: if request.auth != null && request.auth.uid == userId
        && resource.data.count < 2
        && request.resource.data.count == resource.data.count + 1;
    }

    // Bloque tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}