rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Setlists existantes
    match /setlists/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Subscription — création autorisée pour plan='free' uniquement, jamais de modification
    // Le webhook Stripe (Admin SDK) peut modifier via bypass des règles
    match /users/{userId}/subscription/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.plan == 'free';
      allow update, delete: if false;
    }

    // Export count — l'utilisateur peut lire/créer/incrémenter (max 3)
    // La création impose count=1 (pas <= 3) pour éviter de brûler le quota en 1 appel
    // L'update vérifie que count ne fait qu'incrémenter de 1 et que < 3
    match /users/{userId}/exports/{monthDoc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count == 1
        && request.resource.data.month == monthDoc;
      allow update: if request.auth != null && request.auth.uid == userId
        && resource.data.count < 3
        && request.resource.data.count == resource.data.count + 1;
    }

    // Bloque tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}